# Docker/Airflow local settings
AIRFLOW_UID=50000

# Supabase connection settings for the database load task.
# Copy this file to .env and set the values for the local environment.
SUPABASE_URL=
SUPABASE_KEY=

# Optional Airflow UI credentials. Defaults are airflow / airflow when omitted.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
