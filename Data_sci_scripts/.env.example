# ============================================================
# Aquablend — environment variables
# 1. Copy this file to ".env"  ->  cp .env.example .env
# 2. Fill in the real values below (never commit ".env")
# 3. .env is already ignored by .gitignore
# ============================================================

# --- Supabase project settings ---
# Find these in Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Direct Postgres connection (for SQLAlchemy / pandas) ---
# Find this in Supabase dashboard -> Project Settings -> Database -> Connection string
# Use the "Session pooler" or "Transaction pooler" URI for scripts/notebooks
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# --- App/environment ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Optional: LLM key for the Analysis & AI explanation layer ---
# ANTHROPIC_API_KEY=your-anthropic-key-here
